# .env.example
# Environment Variables Template for Doc-Understand
# Copy this to .env and fill in your actual values
# DO NOT commit .env to GitHub (contains secrets!)

# ========================================
# Google Cloud Platform
# ========================================
GCP_PROJECT_ID=doc-understand
GCS_BUCKET=doc-understand-gcs-bucket
GOOGLE_APPLICATION_CREDENTIALS=gcp_keys/doc-understand-XXXXX.json

# ========================================
# AWS (for Textract)
# ========================================
AWS_ACCESS_KEY_ID=your-aws-access-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here
AWS_REGION=us-east-1
S3_BUCKET=textract-bucket-yash07

# ========================================
# Groq LLM API
# ========================================
GROQ_API_KEY=your-groq-api-key-here

# ========================================
# Application Settings
# ========================================
USE_GCS_OUTPUT=true
WRITE_LOCAL_COPY=false

# ========================================
# Cloud Run Settings (set automatically)
# ========================================
PORT=8080
